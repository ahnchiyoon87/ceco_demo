{
  "uid": "ar100-ml",
  "title": "AR-100 · ML 이상 탐지 (Tier-2)",
  "tags": [
    "ar100",
    "ml"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Autoencoder 재구성 오차 vs 임계치",
      "description": "정상 패턴과의 괴리가 커지면 재구성 오차가 임계치를 넘습니다. 단일 센서 임계치로는 잡히지 않는 센서 간 상관구조 붕괴를 탐지합니다.",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"process\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly\")\n  |> filter(fn: (r) => r._field == \"reconstruction_error\" or r._field == \"threshold\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "threshold"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "추론 지연 (임베디드 ONNX)",
      "description": "TaskManager 프로세스 내부에서 직접 추론하므로 네트워크 홉이 없습니다.",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"process\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r._field == \"inference_ms\")\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "이상 판정 건수",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"process\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r._field == \"is_anomaly\")\n  |> filter(fn: (r) => r._value == true)\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "이상 기여도 상위 센서 (역추적)",
      "description": "재구성 오차에 기여한 센서 차원을 역추적한 결과입니다.",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"process\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r._field == \"reconstruction_error\")\n  |> filter(fn: (r) => exists r.top_contributors)\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 40)\n  |> keep(columns: [\"_time\", \"_value\", \"top_contributors\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      }
    }
  ]
}