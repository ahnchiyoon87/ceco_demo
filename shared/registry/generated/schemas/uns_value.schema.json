{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://ar100.local/schemas/uns_value.schema.json",
 "title": "UNS 값(Sparkplug 규칙을 JSON으로 흉내: 출처 시각·품질·순번)",
 "type": "object",
 "required": [
  "ts",
  "value",
  "quality"
 ],
 "properties": {
  "ts": {
   "type": "integer",
   "description": "출처 시각(epoch ns, 엣지가 읽은 시각)"
  },
  "value": {
   "type": [
    "number",
    "null"
   ]
  },
  "quality": {
   "enum": [
    "GOOD",
    "UNCERTAIN",
    "BAD",
    "STALE"
   ]
  },
  "seq": {
   "type": "integer",
   "description": "현장 장치 스캔 순번"
  },
  "pts": {
   "type": "integer",
   "description": "설비 시각(초)"
  }
 }
}
