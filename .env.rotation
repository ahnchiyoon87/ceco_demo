# 실험 스택 전용 덮어쓰기. 비밀값 없음.
# 원본 V1(D:\work\study\lecture-iiot-scada, 27xxx·28xxx)과 같은 머신에서 동시에 떠도 겹치지 않게
# 프로젝트명·컨테이너명·네트워크·호스트 포트를 모두 바꾼다.
#
# SCADA:  원본 이미지(iiot/flink-onnx·iiot/plant-simulator)가 없어 원본 compose 그대로는 뜨지 않는다. HANDOFF §5 안정화 V1 명령을 쓴다.
#         docker compose --env-file .env --env-file .env.rotation up -d --no-build   # 원본 이름(iiot/*) 이미지 빌드 금지 — HANDOFF §7·§8
# AI:     docker compose -p rot-ai --env-file ai-layer/.env.local --env-file .env.rotation \
#           -f ai-layer/compose.yml -f ai-layer/compose.scada.yml --profile knowledge up -d --no-build
# (Windows compose 는 COMPOSE_FILE 구분자로 ';' 를 기대하므로 아래에서 구분자를 명시한다)

COMPOSE_PROJECT_NAME=rot-iiot
COMPOSE_PATH_SEPARATOR=:
CN_PREFIX=rot-
SCADA_NETWORK=rot-iiot

PORT_SIM_MODBUS=37002
PORT_SIM_API=37080
PORT_EMQX_MQTT=37083
PORT_EMQX_DASHBOARD=37183
PORT_KAFKA=37092
PORT_FLINK_UI=37081
PORT_INFLUXDB=37086
PORT_GRAFANA=37030
PORT_FUXA=37018
PORT_PROMETHEUS=37090
PORT_ALERTMANAGER=37093
PORT_EDGEX_UI=37040
PORT_EDGEX_COMMAND=37882
PORT_EDGEX_MODBUS=37901
PORT_EDGEX_EXPORT=37704

AI_PORT_WEB=38180
AI_PORT_KNOWLEDGE=38000
AI_PORT_DB=37532
AI_PORT_GRAPH_HTTP=37474
AI_PORT_GRAPH_BOLT=37687
