<?xml version="1.0"?>
<!--
  수집 후보 P1: HiveMQ Edge 2026.14 — Modbus 어댑터 + 내장 MQTT 브로커 (CANDIDATES §2·§3, 패턴 P-EB)
  V1 이 하던 일: EdgeX device-modbus + app-mqtt-export + EMQX(브로커)
  재현 방법: Modbus 어댑터가 HR 0~23 float32 12태그를 1초마다 읽어(publishChangedDataOnly=false) 태그마다
            edgex/telemetry/<tag> 로 QoS1 발행. 페이로드는 제품 고정 JSON({"value":..,"timestamp":..,"tagName":..}).
  알려진 차이: EdgeX Event 모양(한 메시지에 12 reading)을 만들 수 없음 — 모양 변환(Data Hub)은 상용 키 기능이라 미사용.
            → V1 Telegraf#1 설정 변경(json_v2 경로·토픽)이 필요. 단절 보관(오프라인 버퍼)도 상용 → 미사용.
  태그 스키마 출처: hivemq-edge 2026.14 modules/hivemq-edge-module-modbus (ModbusTagDefinition, ModbusDataType)
-->
<hivemq xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="config.xsd">
    <mqtt-listeners>
        <tcp-listener>
            <port>1883</port>
            <bind-address>0.0.0.0</bind-address>
        </tcp-listener>
        <websocket-listener>
            <port>8083</port>
            <bind-address>0.0.0.0</bind-address>
            <path>/mqtt</path>
            <subprotocols>
                <subprotocol>mqttv3.1</subprotocol>
                <subprotocol>mqtt</subprotocol>
            </subprotocols>
            <allow-extensions>true</allow-extensions>
        </websocket-listener>
    </mqtt-listeners>
    <!-- V1 보장 맞춤(09-29): 내장 브로커 오프라인 큐 기본 1000 → 100000(V1 EMQX max_mqueue_len). 키 이름 [미검증] -->
    <mqtt>
        <queued-messages>
            <max-queue-size>100000</max-queue-size>
            <strategy>discard</strategy>
        </queued-messages>
    </mqtt>
    <protocol-adapters>
        <protocol-adapter>
            <adapterId>ar100-modbus</adapterId>
            <protocolId>modbus</protocolId>
            <config>
                <host>plant-simulator</host>
                <port>502</port>
                <timeoutMillis>1000</timeoutMillis>
                <modbusToMqtt>
                    <pollingIntervalMillis>1000</pollingIntervalMillis>
                    <maxPollingErrorsBeforeRemoval>-1</maxPollingErrorsBeforeRemoval><!-- R11: 설비 통신 끊김 뒤에도 어댑터가 제거되지 않게(-1 = 무제한으로 해석되는지 [미검증]) -->
                    <publishChangedDataOnly>false</publishChangedDataOnly>
                </modbusToMqtt>
            </config>
            <northboundMappings>
                <northboundMapping>
                    <topic>edgex/telemetry/LT-101</topic>
                    <maxQos>1</maxQos>
                    <messageHandlingOptions>MQTTMessagePerSubscription</messageHandlingOptions>
                    <tagName>LT-101</tagName>
                    <includeTagNames>true</includeTagNames>
                    <includeTimestamp>true</includeTimestamp>
                </northboundMapping>
                <northboundMapping>
                    <topic>edgex/telemetry/LT-102</topic>
                    <maxQos>1</maxQos>
