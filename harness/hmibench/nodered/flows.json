 {
  "id": "fn1",
  "type": "function",
  "z": "tab",
  "name": "최신값 저장",
  "func": "const t = global.get('tags') || {};\nconst p = msg.payload;\nt[p.tag] = {value: p.value, ts: p.ts, seq: p.seq, recv_ms: Date.now()};\nglobal.set('tags', t);\nmsg.payload = Object.keys(t).sort().map(k => ({tag: k, value: t[k].value}));\nreturn msg;",
  "outputs": 1,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "wires": [
   [
    "tbl"
   ]
  ]
 },
 {
