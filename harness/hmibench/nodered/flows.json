 {
  "id": "fn3",
  "type": "function",
  "z": "tab",
  "name": "알람 목록",
  "func": "const a = global.get('alerts') || [];\na.unshift({topic: msg.topic, body: msg.payload, recv_ms: Date.now()});\nglobal.set('alerts', a.slice(0, 50));\nreturn null;",
  "outputs": 1,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "wires": [
   []
  ]
 },
