    "fc"
   ]
  ]
 },
 {
  "id": "fc",
  "type": "function",
  "z": "tab",
  "name": "명령 검증·감사",
  "func": "const allow = {agitator_run: 1, cooler_enable: 3};\nconst b = msg.payload || {};\nconst audit = global.get('audit') || [];\nconst rec = {at: new Date().toISOString(), user: msg.req.benchUser || null, target: b.target, value: b.value};\nif (!(b.target in allow) || ![0, 1, true, false].includes(b.value)) {\n  rec.result = 'rejected'; audit.push(rec); global.set('audit', audit);\n  msg.statusCode = 400; msg.payload = {ok: false, reason: 'not allowed'}; return [null, msg];\n}\nrec.result = 'dispatched'; audit.push(rec); global.set('audit', audit);\nmsg.payload = {value: !!b.value, fc: 5, unitid: 1, address: allow[b.target], quantity: 1};\nreturn [msg, null];",
  "outputs": 2,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "wires": [
   [
    "mfw"
   ],
   [
    "r3"
   ]
  ]
 },
 {
  "id": "mfw",
  "type": "modbus-flex-write",
  "z": "tab",
  "name": "코일 쓰기",
  "showStatusActivities": false,
  "showErrors": true,
  "showWarnings": true,
  "server": "mbc",
  "emptyMsgOnFail": false,
  "keepMsgProperties": true,
  "delayOnStart": false,
  "startDelayTime": "",
