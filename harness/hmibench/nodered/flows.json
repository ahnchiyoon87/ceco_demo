   ],
   []
  ]
 },
 {
  "id": "fok",
  "type": "function",
  "z": "tab",
  "name": "응답",
  "func": "msg.statusCode = 200; msg.payload = {ok: true, written: msg.payload};\nreturn msg;",
  "outputs": 1,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "wires": [
   [
    "r3"
   ]
  ]
 },
 {
  "id": "cat",
