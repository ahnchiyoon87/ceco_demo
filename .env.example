# ceco_demo 설정 견본. `cp .env.example .env` 뒤 CHANGE_ME 자리(비밀번호·토큰)를 각자 정한 값으로 바꾼다.
# .env 는 git 에 올리지 않는다(.gitignore). OpenAI 키는 5_ai/server/.env.local 의 OPENAI_API_KEY.

# ═══════════════════════════════════════════════════════════════════════════
# AR-100 IIoT·SCADA 베이스 — 전역 설정(교육용 데모 기본값, 저장소에 포함)
# 실제 운영에 쓰려면 비밀번호·토큰을 모두 바꾼다. LLM 키는 5_ai/server/.env.local 에만 둔다(저장소 밖).
# ═══════════════════════════════════════════════════════════════════════════
COMPOSE_PROJECT_NAME=ceco-demo

# ── 망 대역: {NET_PREFIX}.10 = OT, .20 = DMZ, .30 = IT (한 PC 의 다른 망과 겹치면 바꾼다) ──
NET_PREFIX=10.231

# ── 이미지 판(latest 금지, §3-1) ──
MOSQUITTO_IMAGE=eclipse-mosquitto:2.1.2-alpine
KAFKA_IMAGE=apache/kafka:4.3.1
ZOOKEEPER_IMAGE=zookeeper:3.9.5
INFLUXDB_IMAGE=influxdb:2.9.1-alpine
POSTGRES_IMAGE=postgres:18.6-alpine
GRAFANA_IMAGE=grafana/grafana:13.2.3
PROMETHEUS_IMAGE=prom/prometheus:v3.13.4
CADDY_IMAGE=caddy:2.11.4-alpine
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.6
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.10.0
BENTO_IMAGE=ghcr.io/warpstreamlabs/bento:1.21.2
FUXA_IMAGE=frangoteam/fuxa:1.3.4
NEO4J_IMAGE=neo4j:5.26.31-community

# ── 호스트 공개 포트(모두 127.0.0.1). OT·DMZ 는 라우터를 거친다 ──
PORT_FUXA=37018
PORT_SIM_API=37080
PORT_FIELD_PANEL=37082
PORT_OT_MQTT=37083
PORT_EDGE_UI=37880
PORT_PLC_API=37443
PORT_DMZ_MQTT=37084
PORT_DMZ_INFLUX=37087
PORT_KAFKA=37092
PORT_FLINK_UI=37081
PORT_IT_INFLUX=37086
PORT_GRAFANA=37030
PORT_PROMETHEUS=37090
PORT_ALERTMANAGER=37093
PORT_PG=37532
PORT_AI_WEB=38180
PORT_AI_KNOWLEDGE=38000
PORT_GRAPH_HTTP=37474
PORT_GRAPH_BOLT=37687

# ── 사람 전용 계정(어떤 컨테이너에도 주지 않는다): 강사·실습 도구, 현장 패널 ──
INSTRUCTOR_USER=instructor
INSTRUCTOR_PASSWORD=CHANGE_ME
FIELD_PANEL_USER=field
FIELD_PANEL_PASSWORD=CHANGE_ME
FIELD_CREW_USER=crew
FIELD_CREW_PASSWORD=CHANGE_ME

# ── soft-PLC 편집기 접속 계정 ──
PLC_ADMIN_USER=plcadmin
PLC_ADMIN_PASSWORD=CHANGE_ME

# ── MQTT 계정(OT 허브) ──
MQTT_EDGE_PASSWORD=CHANGE_ME
MQTT_RECEIVER_PASSWORD=CHANGE_ME
MQTT_FUXA_PASSWORD=CHANGE_ME
MQTT_VIEWER_PASSWORD=CHANGE_ME
MQTT_OT_EXPORTER_PASSWORD=CHANGE_ME
# ── MQTT 계정(DMZ 브로커) ──
MQTT_BRIDGE_PASSWORD=CHANGE_ME
MQTT_DMZ_LOADER_PASSWORD=CHANGE_ME
MQTT_GATEWAY_PASSWORD=CHANGE_ME
MQTT_IT_COLLECTOR_PASSWORD=CHANGE_ME
MQTT_DMZ_EXPORTER_PASSWORD=CHANGE_ME

# ── 엣지 편집 화면(Node-RED) 계정 ──
EDGE_ADMIN_USER=edgeadmin
EDGE_ADMIN_PASSWORD=CHANGE_ME

# ── InfluxDB: DMZ(원시 사본) / IT(Flink 결과) ──
INFLUX_ORG=ar100
DMZ_INFLUX_BUCKET=plant_raw
DMZ_INFLUX_USER=dmzadmin
DMZ_INFLUX_PASSWORD=CHANGE_ME
DMZ_INFLUX_TOKEN=CHANGE_ME
# IT(AI·Grafana)가 DMZ 사본을 읽는 v1 호환 읽기 전용 계정(InfluxQL). 쓰기 권한 없음
DMZ_INFLUX_READER_USER=it-reader
DMZ_INFLUX_READER_PASSWORD=CHANGE_ME
IT_INFLUX_BUCKET=process
IT_INFLUX_USER=itadmin
IT_INFLUX_PASSWORD=CHANGE_ME
IT_INFLUX_TOKEN=CHANGE_ME

# ── PostgreSQL 18(공용 업무 DB): 스키마 4개 + AI DATABASE, 서비스별 계정 ──
PG_SUPERUSER_PASSWORD=CHANGE_ME
PG_OPS_PASSWORD=CHANGE_ME
PG_DISPATCHER_PASSWORD=CHANGE_ME
PG_AI_PASSWORD=CHANGE_ME
PG_MES_PASSWORD=CHANGE_ME
PG_READER_PASSWORD=CHANGE_ME

# ── DMZ 요청 게이트웨이: IT 발송기만 쓰는 토큰 ──
GATEWAY_CLIENT_TOKEN=CHANGE_ME

# ── Grafana ──
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# ── Neo4j(AI 지식 그래프) ──
NEO4J_PASSWORD=CHANGE_ME
# FUXA 로그인(수업용 데모 값 — 배포 전 바꾼다). 운전원 명령은 로그인한 사용자만, 화면 변경은 관리자만
FUXA_ADMIN_PASSWORD=CHANGE_ME
FUXA_OPERATOR_PASSWORD=CHANGE_ME
FUXA_JWT_SECRET=CHANGE_ME
# 브로커 끊김 버퍼 한도(건, 17번 D10): 초당 약 20건 × 1시간. 바이트 상한은 설정 파일(32 MiB)
MQTT_MAX_QUEUED_MESSAGES=72000
# FUXA 앞 인증 관문(사람용 공개 포트)
HMI_GATE_USER=plant
HMI_GATE_PASSWORD=CHANGE_ME
