<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_AR100" targetNamespace="https://example.local/ar100/pilot">
  <bpmn:process id="AR100_Mixer_Response" name="AR-100 교반기 이상 대응 - 설계 예시" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AR100">
      <bpmn:lane id="Lane_Intake" name="Intake">
        <bpmn:flowNodeRef>Start_Alarm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent">
        <bpmn:flowNodeRef>Task_Analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Hold</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operator" name="Operator">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Action" name="Action">
        <bpmn:flowNodeRef>Task_Revalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Readback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Uncertain</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Alarm" name="Kafka 알람 수신">
      <bpmn:messageEventDefinition id="MessageStart_AR100" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Record" name="사건과 원본 알람 저장" />
    <bpmn:serviceTask id="Task_Analyze" name="실제 근거 조회" />
    <bpmn:exclusiveGateway id="Gateway_Evidence" name="근거 충분?" />
    <bpmn:serviceTask id="Task_Hold" name="근거 부족으로 보류" />
    <bpmn:endEvent id="End_Hold" name="보류" />
    <bpmn:serviceTask id="Task_Propose" name="허용 조치 제안" />
    <bpmn:userTask id="Task_Review" name="담당자 검토" />
    <bpmn:exclusiveGateway id="Gateway_Approval" name="승인?" />
    <bpmn:endEvent id="End_Rejected" name="거절" />
    <bpmn:serviceTask id="Task_Revalidate" name="현재 조건 재검사" />
    <bpmn:exclusiveGateway id="Gateway_Valid" name="유효?" />
    <bpmn:endEvent id="End_Expired" name="재검토" />
    <bpmn:serviceTask id="Task_Stop" name="Modbus 교반기 정지" />
    <bpmn:serviceTask id="Task_Readback" name="새 상태 되읽기" />
    <bpmn:exclusiveGateway id="Gateway_Verified" name="정지 확인?" />
    <bpmn:endEvent id="End_Confirmed" name="확인 완료" />
    <bpmn:endEvent id="End_Uncertain" name="불확실·수동 확인" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Alarm" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Record" targetRef="Task_Analyze" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Analyze" targetRef="Gateway_Evidence" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Evidence" targetRef="Task_Hold" name="아니오" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Hold" targetRef="End_Hold" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Evidence" targetRef="Task_Propose" name="예" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Propose" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Review" targetRef="Gateway_Approval" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_Approval" targetRef="End_Rejected" name="거절" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Approval" targetRef="Task_Revalidate" name="승인" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Revalidate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Valid" targetRef="End_Expired" name="변경됨" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_Valid" targetRef="Task_Stop" name="유효" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Stop" targetRef="Task_Readback" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Readback" targetRef="Gateway_Verified" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Verified" targetRef="End_Confirmed" name="확인" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_Verified" targetRef="End_Uncertain" name="불확실" />
  </bpmn:process>
</bpmn:definitions>